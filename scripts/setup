#!/usr/bin/env bash
# Get a clean checkout to a runnable state. Must be idempotent.
set -euo pipefail
cd "$(dirname "$0")/.."

chmod +x scripts/*

# XCTest ships only with Xcode, not the Command Line Tools, so `swift test` needs it.
if ! xcode-select -p | grep -q '\.app/'; then
  printf '\033[31m✗ Xcode is not the active developer directory. Install Xcode 14.2, then:\n  sudo xcode-select -s /Applications/Xcode.app\033[0m\n' >&2
  exit 1
fi

swift package resolve
swift build
swift build --package-path Tools -c release

echo "✓ setup complete"
