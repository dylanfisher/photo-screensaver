#!/usr/bin/env bash
# Build and launch the app. The ONE place the run command is written down —
# AGENTS.md and README point here rather than repeating it.
set -euo pipefail
cd "$(dirname "$0")/.."

bundle=.build/PhotoScreensaver.app
./scripts/bundle "$bundle"

# `open` would just reactivate an instance that is still quitting.
pkill -x PhotoScreensaver && while pgrep -x PhotoScreensaver >/dev/null; do sleep 0.2; done
open "$bundle" --args "$@"
echo "✓ launched $bundle"
